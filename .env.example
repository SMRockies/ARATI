# Runtime
NODE_ENV=development

# PostgreSQL
POSTGRES_DB=arati_erp
POSTGRES_USER=arati
POSTGRES_PASSWORD=change-this-local-password
POSTGRES_PORT=5432
DATABASE_URL=postgresql://arati:change-this-local-password@localhost:5432/arati_erp?schema=public

# Application ports reserved for later Phase 0 runtime shells
API_PORT=3001
WEB_PORT=3000

# Browser origins allowed to call the API with credentials (comma-separated, no trailing slash).
# First entry is the ARATI ERP web shell; additional entries may be the ARATI_1 market frontend.
CORS_ORIGIN=http://localhost:3000,http://localhost:3002

# Organization id whose catalogue the public market API (/api/v1/market) serves.
# Optional when exactly one organization exists (single-tenant deployments);
# required once more than one organization exists, otherwise the market API
# fails closed with 503 MARKET_NOT_CONFIGURED.
MARKET_ORGANIZATION_ID=

# Private API-local storage for inventory receipt proof files (JPEG, PNG, PDF; max 10 MB).
# Mount durable, access-controlled storage at this path for deployments.
INVENTORY_PROOF_STORAGE_DIR=var/inventory-proofs
